<Project Sdk="Microsoft.NET.Sdk">

  <!-- The source of truth is the Unity package folder; this project only compiles
       those same files for tests and benchmarks outside Unity. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Match3Lab.Core</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../packages/com.rizgarozan.match3lab.core/Runtime/**/*.cs" LinkBase="Runtime" />
  </ItemGroup>

</Project>
